# Server-only MongoDB Atlas connection. Never use NEXT_PUBLIC_ for credentials.
MONGODB_URI=
MONGODB_DB=vaagai_jaguar

# Google OAuth (server only). See AUTH_SETUP.md for Google and Vercel setup.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
# The exact deployed origin, without a trailing slash.
# AUTH_URL=https://vaagai-zeta.vercel.app

# Set to the public HTTPS origin when deploying behind a reverse proxy.
# JAGUAR_APP_ORIGIN=https://jaguar.example.com

# Optional River Guide configuration. Never expose these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
