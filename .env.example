# Persistent SQLite database and private uploads. Use a mounted disk in production.
JAGUAR_DATA_DIR=./data

# Enable ONLY behind an authenticated gateway that strips/overwrites incoming
# oai-authenticated-user-* headers and prevents direct access to this server.
JAGUAR_TRUST_AUTH_HEADERS=false

# Set to the public HTTPS origin when deploying behind a reverse proxy.
# JAGUAR_APP_ORIGIN=https://jaguar.example.com

# Optional River Guide configuration. Never expose these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
